---
// Satu halaman utuh. Dipakai oleh ketiga rute bahasa; teksnya dari src/lib/teks.ts.
import '../styles.css';
import { TEKS, BAHASA, NAMA_BAHASA, JALUR, PORTOFOLIO, type Bahasa } from '../lib/teks';

interface Props { bahasa: Bahasa }
const { bahasa } = Astro.props;
const t = TEKS[bahasa];
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${BASE}/${p.replace(/^\//, '')}`;
const situs = Astro.site ? new URL(u(JALUR[bahasa]), Astro.site).href : u(JALUR[bahasa]);
const surel = 'mufuyumoku@gmail.com';
---

<!doctype html>
<html lang={NAMA_BAHASA[bahasa].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.judulTab}</title>
    <meta name="description" content={t.deskripsi} />
    <link rel="canonical" href={situs} />
    {BAHASA.map((b) => (
      <link rel="alternate" hreflang={NAMA_BAHASA[b].lang} href={Astro.site ? new URL(u(JALUR[b]), Astro.site).href : u(JALUR[b])} />
    ))}
    <link rel="alternate" hreflang="x-default" href={Astro.site ? new URL(u('/'), Astro.site).href : u('/')} />
    <meta property="og:title" content="Pyonkuro" />
    <meta property="og:description" content={t.deskripsi} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={situs} />
    <meta name="theme-color" content="#0e0d0b" />
    <link rel="icon" type="image/svg+xml" href={u('/pyonkuro-chip.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <clipPath id="tepi"><circle cx="256" cy="256" r="236" /></clipPath>
        <g id="pyonkuro">
          <circle cx="256" cy="256" r="236" fill="#151515" />
          <g fill="#C9A24D" clip-path="url(#tepi)">
            <rect x="236" y="14" width="40" height="58" id="takik" />
            {[45, 90, 135, 180, 225, 270, 315].map((r) => <use href="#takik" transform={`rotate(${r} 256 256)`} />)}
          </g>
          <circle cx="256" cy="256" r="236" fill="none" stroke="#C9A24D" stroke-width="5" />
          <circle cx="256" cy="256" r="158" fill="none" stroke="#C9A24D" stroke-width="7" />
          <g fill="#C9A24D">
            <path d="M214 246 C210 208 212 172 223 150 C236 170 248 208 250 246 Z" />
            <path d="M262 246 C264 208 276 170 290 150 C300 172 302 208 298 246 Z" />
            <circle cx="256" cy="300" r="72" />
          </g>
        </g>
      </defs>
    </svg>

    <div class="wrap">
      <nav class="bahasa" aria-label={t.pilihBahasa}>
        {BAHASA.map((b) => (
          <a href={u(JALUR[b])} hreflang={NAMA_BAHASA[b].lang} lang={NAMA_BAHASA[b].lang}
             aria-current={b === bahasa ? 'page' : undefined}>{NAMA_BAHASA[b].label}</a>
        ))}
      </nav>

      <header class="kepala">
        <div>
          <p class="kepala__kana" lang="ja">ぴょんくろ</p>
          <h1>Pyonkuro</h1>
          <p class="kepala__lead">{t.lead}</p>
          <p class="kepala__nama">
            <b>pyon</b> — {t.arti[0]} &nbsp;·&nbsp; <b>kuro</b> — {t.arti[1]} &nbsp;·&nbsp; {t.arti[2]} <b>Pyuro</b>
          </p>
        </div>
        <svg class="chip-besar" viewBox="0 0 512 512" role="img" aria-label={t.altChip}><use href="#pyonkuro" /></svg>
      </header>

      <section id="karya" aria-labelledby="judul-karya">
        <p class="judul-bagian"><svg viewBox="0 0 512 512" aria-hidden="true"><use href="#pyonkuro" /></svg>{t.karya.label}</p>
        <h2 id="judul-karya">{t.karya.judul}</h2>
        <p class="pengantar">{t.karya.pengantar}</p>
        <div class="karya">
          <article class="karya__item">
            <p class="karya__jenis">{t.karya.onsa.jenis}</p>
            <h3 class="karya__judul">Onsa <span class="karya__kanji" lang="ja">音叉</span></h3>
            <p class="karya__isi">{t.karya.onsa.isi}</p>
            <div class="karya__kaki">
              <a class="tautan" href="https://github.com/MufuyuMoku/onsa/releases/latest" rel="noopener">{t.karya.onsa.aksi}</a>
            </div>
          </article>
          <article class="karya__item">
            <p class="karya__jenis">{t.karya.saku.jenis}</p>
            <h3 class="karya__judul">Saku Pajak</h3>
            <p class="karya__isi">{t.karya.saku.isi}</p>
            <div class="karya__kaki">
              <a class="tautan" href="https://mufuyumoku.github.io/tax/" rel="noopener">{t.karya.saku.aksi}</a>
            </div>
          </article>
        </div>
        <p class="lanjut">{t.karya.lanjutSebelum}<a class="tautan" href={PORTOFOLIO[bahasa]}>{t.karya.lanjutTautan}</a>{t.karya.lanjutSesudah}</p>
      </section>

      <section id="jasa" aria-labelledby="judul-jasa">
        <p class="judul-bagian"><svg viewBox="0 0 512 512" aria-hidden="true"><use href="#pyonkuro" /></svg>{t.jasa.label}</p>
        <h2 id="judul-jasa">{t.jasa.judul}</h2>
        <ul class="jasa">
          {t.jasa.daftar.map((j) => (
            <li>
              <h3>{j.judul}</h3>
              <p>{j.isi}</p>
              <p class="bukti">{j.contoh}</p>
            </li>
          ))}
        </ul>
        <p class="catatan-harga">{t.jasa.harga}</p>
      </section>

      <section id="cara" aria-labelledby="judul-cara">
        <p class="judul-bagian"><svg viewBox="0 0 512 512" aria-hidden="true"><use href="#pyonkuro" /></svg>{t.cara.label}</p>
        <h2 id="judul-cara">{t.cara.judul}</h2>
        <ol class="langkah">
          {t.cara.langkah.map(([judul, isi]) => (
            <li><div><b>{judul}</b><span>{isi}</span></div></li>
          ))}
        </ol>
      </section>

      <section id="kontak" aria-labelledby="judul-kontak">
        <p class="judul-bagian"><svg viewBox="0 0 512 512" aria-hidden="true"><use href="#pyonkuro" /></svg>{t.kontak.label}</p>
        <h2 id="judul-kontak">{t.kontak.judul}</h2>
        <div class="kontak">
          <div>
            <p class="surel" id="surel"><a href={`mailto:${surel}`}>{surel}</a></p>
            <p class="whatsapp">{t.kontak.whatsapp}: <span>@Mufuyu</span></p>
          </div>
          <button class="salin" id="salin" type="button"
                  data-salin={t.kontak.salin} data-tersalin={t.kontak.tersalin} data-tekan={t.kontak.tekanSalin}>{t.kontak.salin}</button>
          <dl class="kontak__lain">
            <div><dt>{t.kontak.github}</dt><dd><a class="tautan" href="https://github.com/MufuyuMoku" rel="noopener me">MufuyuMoku</a></dd></div>
            <div><dt>{t.kontak.portofolio}</dt><dd><a class="tautan" href={PORTOFOLIO[bahasa]}>{PORTOFOLIO[bahasa].replace('https://', '').replace(/\/$/, '')}</a></dd></div>
          </dl>
        </div>
      </section>

      <footer>
        <svg viewBox="0 0 512 512" aria-hidden="true"><use href="#pyonkuro" /></svg>
        <span>{t.kaki} · 2026</span>
      </footer>
    </div>

    <script>
      const tombol = document.getElementById('salin') as HTMLButtonElement;
      const surel = document.getElementById('surel') as HTMLElement;
      const d = tombol.dataset;
      tombol.addEventListener('click', () => {
        const pilih = () => {
          const r = document.createRange(); r.selectNodeContents(surel);
          const s = window.getSelection(); s?.removeAllRanges(); s?.addRange(r);
          tombol.textContent = d.tekan ?? '';
        };
        try {
          navigator.clipboard.writeText(surel.textContent!.trim()).then(() => { tombol.textContent = d.tersalin ?? ''; }, pilih);
        } catch { pilih(); }
        setTimeout(() => { tombol.textContent = d.salin ?? ''; }, 2200);
      });
    </script>
  </body>
</html>
