# Daftar rahasia Meja Depan. JANGAN isi nilai di berkas ini dan jangan commit nilainya.
#
# Di produksi: simpan sebagai GitHub repository secrets (Settings → Secrets and
# variables → Actions). Workflow .github/workflows/meja-depan.yml memasangnya ke worker.
#
# Untuk mencoba di komputer sendiri: salin berkas ini menjadi meja-depan/.dev.vars
# (sudah diabaikan git), lalu isi nilainya di sana.

# Untuk memasang worker (dipakai workflow, tidak dibaca worker)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Laporan ke Telegram (saluran utama)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anti-spam Cloudflare Turnstile (kunci rahasia; site key publik ada di konfigurasi/umum.json)
TURNSTILE_SECRET_KEY=

# Surel ke pemilik lewat Resend (saluran kedua, boleh kosong)
RESEND_API_KEY=

# Opsional: Claude API sebagai penyedia AI pengganti Workers AI
ANTHROPIC_API_KEY=
