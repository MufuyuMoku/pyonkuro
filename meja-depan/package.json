{
  "name": "meja-depan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "periksa": "tsc --noEmit && tsc -p tsconfig.situs.json && tsc -p tsconfig.e2e.json",
    "cek-bundel": "wrangler deploy --dry-run --outdir .keluaran",
    "e2e:bangun": "cd .. && MEJA_DEPAN_URL=http://127.0.0.1:8799 npx astro build --outDir meja-depan/.e2e-situs",
    "e2e": "npm run e2e:bangun && vitest run -c vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^22.20.5",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  }
}
